# Server Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────
NODE_ENV=development
PORT=5000

# ─── PostgreSQL (Render.com) ──────────────
DATABASE_URL=postgresql://user:password@host:5432/cinick_db?sslmode=require

# ─── JWT ──────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_here_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── CORS ─────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Bcrypt ───────────────────────────────
BCRYPT_ROUNDS=12

# ─── Rate Limiter ─────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logging ──────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs
