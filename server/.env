# Server Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────
NODE_ENV=development
PORT=5000

# ─── PostgreSQL (Render.com) ──────────────
DATABASE_URL=postgresql://klinik_vqx4_user:wTeHkQtXntZkgyM8lBIAGvZ78r8ruhvM@dpg-d7s8hdn7f7vs73dgbi50-a.virginia-postgres.render.com/klinik_vqx4?sslmode=no-verify
# ─── JWT ──────────────────────────────────
JWT_ACCESS_SECRET=sekret
JWT_REFRESH_SECRET=sekret
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=7d

# ─── CORS ─────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Bcrypt ───────────────────────────────
BCRYPT_ROUNDS=12

# ─── Rate Limiter ─────────────────────────
